{
  "name": "Geocode location query",
  "method": "GET",
  "path": "/stations/geocode/",
  "auth": "optional",
  "description": "Search Naver Cloud Maps Geocoding first, then NAVER Developers Local Search when no normalized address result is available.",
  "query": {
    "required": ["query"],
    "properties": {
      "query": {
        "type": "string",
        "description": "Address, administrative district, building, business, or landmark name.",
        "example": "멀티캠퍼스"
      }
    }
  },
  "responses": {
    "200": {
      "type": "object",
      "required": ["results", "meta"],
      "additionalProperties": false,
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "address", "road_address", "jibun_address", "latitude", "longitude", "source"],
            "additionalProperties": false,
            "properties": {
              "name": {"type": "string"},
              "address": {"type": "string"},
              "road_address": {"type": "string"},
              "jibun_address": {"type": "string"},
              "latitude": {"type": "number"},
              "longitude": {"type": "number"},
              "source": {"type": "string", "enum": ["naver_geocode", "naver_local_search"]},
              "category": {"type": "string", "description": "Present only for NAVER Local Search results."}
            }
          }
        },
        "meta": {
          "oneOf": [
            {
              "title": "A - Geocode results",
              "type": "object",
              "required": ["source", "status", "count"],
              "additionalProperties": false,
              "properties": {
                "source": {"const": "naver_geocode"},
                "status": {"const": "ok"},
                "count": {"type": "integer", "minimum": 0}
              }
            },
            {
              "title": "B - Empty geocode, local results",
              "type": "object",
              "required": ["source", "status", "count", "fallback_from", "fallback_reason"],
              "additionalProperties": false,
              "properties": {
                "source": {"const": "naver_local_search"},
                "status": {"const": "ok"},
                "count": {"type": "integer", "minimum": 1},
                "fallback_from": {"const": "naver_geocode"},
                "fallback_reason": {"const": "GEOCODE_EMPTY"}
              }
            },
            {
              "title": "C - Unavailable geocode, local results",
              "type": "object",
              "required": ["source", "status", "count", "fallback_from", "fallback_reason"],
              "additionalProperties": false,
              "properties": {
                "source": {"const": "naver_local_search"},
                "status": {"const": "ok"},
                "count": {"type": "integer", "minimum": 1},
                "fallback_from": {"const": "naver_geocode"},
                "fallback_reason": {"type": "string", "not": {"const": "GEOCODE_EMPTY"}}
              }
            },
            {
              "title": "D - Both providers unavailable",
              "type": "object",
              "required": ["source", "status", "reason", "fallback_source", "fallback_status", "fallback_reason"],
              "additionalProperties": false,
              "properties": {
                "source": {"const": "naver_geocode"},
                "status": {"const": "unavailable"},
                "reason": {"type": "string"},
                "fallback_source": {"const": "naver_local_search"},
                "fallback_status": {"const": "unavailable"},
                "fallback_reason": {"type": "string"}
              }
            },
            {
              "title": "E - Empty geocode, local unavailable",
              "type": "object",
              "required": ["source", "status", "count", "fallback_source", "fallback_status", "fallback_reason"],
              "additionalProperties": false,
              "properties": {
                "source": {"const": "naver_geocode"},
                "status": {"const": "ok"},
                "count": {"const": 0},
                "fallback_source": {"const": "naver_local_search"},
                "fallback_status": {"const": "unavailable"},
                "fallback_reason": {"type": "string"}
              }
            },
            {
              "title": "F - Both providers empty",
              "type": "object",
              "required": ["source", "status", "count", "fallback_source", "fallback_status", "fallback_count"],
              "additionalProperties": false,
              "properties": {
                "source": {"const": "naver_geocode"},
                "status": {"const": "ok"},
                "count": {"const": 0},
                "fallback_source": {"const": "naver_local_search"},
                "fallback_status": {"const": "ok"},
                "fallback_count": {"const": 0}
              }
            },
            {
              "title": "G - Unavailable geocode, local empty",
              "type": "object",
              "required": ["source", "status", "reason", "fallback_source", "fallback_status", "fallback_count"],
              "additionalProperties": false,
              "properties": {
                "source": {"const": "naver_geocode"},
                "status": {"const": "unavailable"},
                "reason": {"type": "string"},
                "fallback_source": {"const": "naver_local_search"},
                "fallback_status": {"const": "ok"},
                "fallback_count": {"const": 0}
              }
            }
          ]
        }
      }
    },
    "400": {
      "type": "object",
      "properties": {
        "code": {"type": "string", "example": "MISSING_QUERY"},
        "message": {"type": "string", "example": "검색어(query) 파라미터가 누락되었습니다."}
      }
    }
  }
}
