{
  "name": "Geocode location query",
  "method": "GET",
  "path": "/stations/geocode/",
  "auth": "optional",
  "description": "사용자가 입력한 주소 또는 랜드마크 검색어를 기반으로 매칭되는 위치의 좌표(위경도) 정보를 조회한다. 네이버 지도 API 등을 경유하여 실시간 조회할 수 있으며, API 설정이 없을 경우 로컬 프리셋에서 부분 일치하는 데이터를 폴백으로 조회한다.",
  "query": {
    "required": [
      "query"
    ],
    "properties": {
      "query": {
        "type": "string",
        "description": "검색할 주소 또는 랜드마크 명칭",
        "example": "강남역"
      }
    }
  },
  "responses": {
    "200": {
      "type": "object",
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "example": "강남역"
              },
              "address": {
                "type": "string",
                "example": "서울특별시 강남구 강남대로 396"
              },
              "latitude": {
                "type": "number",
                "example": 37.4979
              },
              "longitude": {
                "type": "number",
                "example": 127.0276
              }
            }
          }
        }
      }
    },
    "400": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "example": "MISSING_QUERY"
        },
        "message": {
          "type": "string",
          "example": "검색어(query) 파라미터가 누락되었습니다."
        }
      }
    }
  }
}
