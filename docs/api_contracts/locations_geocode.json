{
  "name": "Geocode location query",
  "method": "GET",
  "path": "/stations/geocode/",
  "auth": "optional",
  "description": "사용자가 입력한 주소 또는 장소 검색어를 기반으로 네이버 Geocoding API 결과를 조회한다. 운영 UX에서는 로컬 프리셋 더미 결과를 노출하지 않는다.",
  "query": {
    "required": [
      "query"
    ],
    "properties": {
      "query": {
        "type": "string",
        "description": "검색할 주소 또는 랜드마크 명칭",
        "example": "강남역"
      }
    }
  },
  "responses": {
    "200": {
      "type": "object",
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "example": "강남역"
              },
              "address": {
                "type": "string",
                "example": "서울특별시 강남구 강남대로 396"
              },
              "latitude": {
                "type": "number",
                "example": 37.4979
              },
              "longitude": {
                "type": "number",
                "example": 127.0276
              },
              "source": {
                "type": "string",
                "example": "naver_geocode"
              }
            }
          }
        },
        "meta": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "example": "naver_geocode"
            },
            "status": {
              "type": "string",
              "example": "ok"
            },
            "count": {
              "type": "number",
              "example": 1
            }
          }
        }
      }
    },
    "400": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "example": "MISSING_QUERY"
        },
        "message": {
          "type": "string",
          "example": "검색어(query) 파라미터가 누락되었습니다."
        }
      }
    }
  }
}
