# ==============================================================================
# SmartFuel Backend API Keys Configuration
# ==============================================================================
# 이 파일을 같은 위치에 `.env` 이름으로 복사한 뒤 실제 값을 채워주세요.
#   copy .env.example .env
#
# ⚠️  .env 파일은 .gitignore에 의해 Git에 올라가지 않습니다.
#     API 키는 팀원에게 별도로 전달받으세요.
# ==============================================================================

# 0. Django runtime
# 로컬 개발에서는 true를 사용합니다. 운영에서는 반드시 false로 설정하세요.
DJANGO_DEBUG=true

# 운영에서는 충분히 길고 예측할 수 없는 값으로 교체해야 합니다.
# PowerShell 생성 예: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=django-insecure-local-development-only-change-me

# 쉼표로 구분합니다. 운영 도메인과 프론트엔드 origin을 명시하세요.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 운영 HTTPS 보안값입니다. 개발에서는 아래 값으로 HTTP를 허용합니다.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

# TLS를 종료하는 신뢰 가능한 reverse proxy 뒤에서만 true로 설정하세요.
DJANGO_TRUST_PROXY_SSL_HEADER=false

# 1. Naver Cloud Platform (NCP) API - Maps & Geocoding & Directions
# 네이버 클라우드 플랫폼(NCP)에서 발급받은 지도/지오코딩 API 서비스 키를 입력하세요.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# (선택) NCP API 키를 별도로 구분하여 지정하고 싶다면 아래 주석을 해제하고 사용하세요.
# NAVER_GEOCODING_CLIENT_ID=
# NAVER_GEOCODING_CLIENT_SECRET=

# 2. Naver OpenAPI - Local Search API
# 네이버 개발자 센터(openapi.naver.com)에서 발급받은 검색(지역) API 키를 입력하세요.
NAVER_LOCAL_CLIENT_ID=
NAVER_LOCAL_CLIENT_SECRET=

# (선택) Local Search API 키를 별도로 구분하여 지정하고 싶다면 아래 주석을 해제하고 사용하세요.
# NAVER_SEARCH_CLIENT_ID=
# NAVER_SEARCH_CLIENT_SECRET=

# 3. Opinet API - Fuel Station Data
# 오피넷(Opinet) 주유소 정보 수집을 위한 API 인증키를 입력하세요.
OPINET_API_KEY=

# 4. Google Gemini API
# 실제 키는 backend/.env에만 입력하고, 이 예시 파일에는 절대 실제 값을 넣지 마세요.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-3.5-flash

# 선택값: 호출 검증과 배치 정규화에서 사용할 안전 한도입니다.
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_OUTPUT_TOKENS=2048
