# ==============================================================================
# SmartFuel Backend API Keys Configuration
# ==============================================================================
# 이 파일을 같은 위치에 `.env` 이름으로 복사한 뒤 실제 값을 채워주세요.
#   copy .env.example .env
#
# ⚠️  .env 파일은 .gitignore에 의해 Git에 올라가지 않습니다.
#     API 키는 팀원에게 별도로 전달받으세요.
# ==============================================================================

# 1. Naver Cloud Platform (NCP) API - Maps & Geocoding & Directions
# 네이버 클라우드 플랫폼(NCP)에서 발급받은 지도/지오코딩 API 서비스 키를 입력하세요.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# (선택) NCP API 키를 별도로 구분하여 지정하고 싶다면 아래 주석을 해제하고 사용하세요.
# NAVER_GEOCODING_CLIENT_ID=
# NAVER_GEOCODING_CLIENT_SECRET=

# 2. Naver OpenAPI - Local Search API
# 네이버 개발자 센터(openapi.naver.com)에서 발급받은 검색(지역) API 키를 입력하세요.
NAVER_LOCAL_CLIENT_ID=
NAVER_LOCAL_CLIENT_SECRET=

# (선택) Local Search API 키를 별도로 구분하여 지정하고 싶다면 아래 주석을 해제하고 사용하세요.
# NAVER_SEARCH_CLIENT_ID=
# NAVER_SEARCH_CLIENT_SECRET=

# 3. Opinet API - Fuel Station Data
# 오피넷(Opinet) 주유소 정보 수집을 위한 API 인증키를 입력하세요.
OPINET_API_KEY=

# 4. SSAFY GMS - Gen AI Management System
# 실제 키는 backend/.env에만 입력하고, 이 예시 파일에는 절대 실제 값을 넣지 마세요.
# 문서 기준 base endpoint: https://gms.ssafy.io/gmsapi/
GMS_API_KEY=
GMS_BASE_URL=https://gms.ssafy.io/gmsapi
GMS_MODEL=gpt-4.1

# OpenAI 호환 호출은 base URL 뒤에 기존 OpenAI endpoint path를 붙입니다.
# 예: https://gms.ssafy.io/gmsapi/api.openai.com/v1/responses
GMS_OPENAI_RESPONSES_PATH=api.openai.com/v1/responses
GMS_KEY_INFO_PATH=key-info

# 선택값: 호출 검증과 배치 정규화에서 사용할 안전 한도입니다.
GMS_TIMEOUT_SECONDS=30
GMS_MAX_INPUT_CHARS=12000
GMS_MAX_OUTPUT_TOKENS=2000
