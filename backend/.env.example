# =================================================================
# SmartFuel Local Development Environment Variables Config
# =================================================================

# 1. Django Basic Settings
DEBUG=True
SECRET_KEY=django-insecure-your-local-development-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1

# 2. Geocoding API Keys (Naver Cloud Platform - Map API)
# 발급처: https://www.ncloud.com/
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here

# 3. Opinet API Keys
# 발급처: https://www.opinet.co.kr/
OPINET_API_KEY=your_opinet_api_key_here

# 4. Selenium & Crawler Config (Optional for Local Ingestion)
# Selenium 원격 그리드 사용 시 기입 (배포 환경 권장)
# SELENIUM_REMOTE_URL=http://localhost:4444/wd/hub
CHROME_BINARY_PATH=
CARD_INGESTION_ALLOWED_DOMAINS=card-search.naver.com
