# ==============================================================================
# SmartFuel Frontend Environment Variables
# ==============================================================================
# 이 파일을 같은 위치에 `.env` 이름으로 복사한 뒤 실제 값을 채워주세요.
#   copy .env.example .env
#
# ⚠️  .env 파일은 .gitignore에 의해 Git에 올라가지 않습니다.
#     API 키는 팀원에게 별도로 전달받으세요.
# ⚠️  VITE_ 접두사가 붙은 변수는 브라우저에 노출됩니다.
#     Secret 키는 절대 여기에 넣지 마세요!
# ==============================================================================

# 백엔드 API 기본 URL (비워두면 /api/v1 사용)
VITE_API_BASE_URL=

# 검색 API 기본 URL (비워두면 /search-api 사용)
VITE_SEARCH_API_BASE_URL=

# 네이버 지도 JavaScript SDK Client ID (NCP에서 발급받은 공개용 Client ID)
VITE_NAVER_MAPS_CLIENT_ID=
